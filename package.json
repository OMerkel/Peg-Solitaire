{
  "name": "peg-solitaire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm run lint:md && npm run lint:biome",
    "lint:md": "markdownlint \"README.md\" \"doc/**/*.md\"",
    "lint:biome": "biome lint html5/src/js html5/src/test vitest.config.js playwright.config.js package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.7",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "markdownlint-cli": "^0.49.1",
    "vitest": "^3.2.4"
  }
}
